<Window x:Class="LucidStream.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lucid-Stream" Width="1160" Height="800" MinWidth="960" MinHeight="640"
        Background="{StaticResource Page}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Lucid-Stream" FontSize="20" FontWeight="SemiBold"/>
                    <Border Background="{StaticResource Accent}" CornerRadius="10" Padding="10,2" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateText}" Foreground="White" FontSize="12"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Research use only. Not for diagnosis or clinical decision-making." Style="{StaticResource Hint}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,6">
            <DockPanel>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Warn}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= Left: patch, outputs, start ================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Patch" Style="{StaticResource CardTitle}"/>
                            <ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Name"
                                      IsEnabled="{Binding IsDisconnected}" Margin="0,0,0,8"/>
                            <Grid Visibility="{Binding IsReplaySelected, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ReplayFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="Session folder containing session.json"/>
                                <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BrowseReplay_Click"/>
                            </Grid>
                            <CheckBox Content="Loop replay" IsChecked="{Binding LoopReplay}" Visibility="{Binding IsReplaySelected, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                                <Button Content="Connect" Command="{Binding ConnectCommand}" Style="{StaticResource Primary}"/>
                                <Button Content="Disconnect" Command="{Binding DisconnectCommand}"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Device" Foreground="{StaticResource Muted}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeviceName}"/>
                                <TextBlock Grid.Row="1" Text="Firmware" Foreground="{StaticResource Muted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Firmware}"/>
                                <TextBlock Grid.Row="2" Text="Battery" Foreground="{StaticResource Muted}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Battery}"/>
                                <TextBlock Grid.Row="3" Text="Fp1" Foreground="{StaticResource Muted}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Fp1Contact}"/>
                                <TextBlock Grid.Row="4" Text="Fp2" Foreground="{StaticResource Muted}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Fp2Contact}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel IsEnabled="{Binding IsNotStreaming}">
                            <TextBlock Text="Outputs" Style="{StaticResource CardTitle}"/>
                            <CheckBox Content="Lab Streaming Layer (LSL)" IsChecked="{Binding LslEnabled}" IsEnabled="{Binding LslAvailable}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LslHint}" Style="{StaticResource Hint}" Margin="20,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding LslStreams}" Margin="20,0,0,8" IsEnabled="{Binding LslEnabled}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled}" Width="160"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="WebSocket" FontWeight="SemiBold" Margin="0,4,0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="ws://localhost:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Port, UpdateSourceTrigger=LostFocus}" Width="60"/>
                                <TextBlock Text="/v1/stream (always on while streaming)" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <CheckBox Content="LAN mode: let paired apps on this network connect" IsChecked="{Binding LanEnabled}"/>
                            <StackPanel Visibility="{Binding LanEnabled, Converter={StaticResource BoolToVis}}" Margin="20,0,0,6">
                                <TextBlock Text="Use only on trusted lab networks. LAN traffic is not encrypted in v1." Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding LanAddresses}" Text="{Binding LanAddress}" IsEditable="True" Width="180" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                            </StackPanel>

                            <TextBlock Text="Recording and filters" FontWeight="SemiBold" Margin="0,8,0,2"/>
                            <CheckBox Content="Save a local session file" IsChecked="{Binding RecordSession}"/>
                            <Grid Margin="20,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding RecordFolder, UpdateSourceTrigger=LostFocus}"/>
                                <Button Grid.Column="1" Content="Open" Margin="8,0,0,0" MinWidth="50" Command="{Binding OpenRecordingsCommand}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Line-noise notch" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding LineFrequencies}" SelectedItem="{Binding LineFrequency}" Width="80"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Start streaming" Command="{Binding StartStreamingCommand}" Style="{StaticResource Primary}" Padding="18,8"/>
                        <Button Content="Stop streaming" Command="{Binding StopStreamingCommand}" Padding="18,8"/>
                    </StackPanel>

                    <Expander Header="Developer" Margin="0,0,0,16">
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <CheckBox Content="Developer mode (simulator, replay, local Listen page)" IsChecked="{Binding DeveloperMode}" IsEnabled="{Binding IsDisconnected}"/>
                                <TextBlock Text="Approved Listen page URL" Margin="0,8,0,2"/>
                                <TextBox Text="{Binding ListenUrl, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="In developer mode, Listen opens the bundled page at http://localhost:8766 instead." Style="{StaticResource Hint}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="BLE latency correction (ms)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding BleLatencyMs, UpdateSourceTrigger=LostFocus}" Width="60"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Study code (optional, no names)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding StudyCode, UpdateSourceTrigger=LostFocus}" Width="120"/>
                                </StackPanel>
                                <Button Content="Export log" Command="{Binding ExportLogCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= Right: listen, apps, markers, live ================= -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Listen" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding ListenStatus}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Listen" Command="{Binding ListenCommand}" Style="{StaticResource Primary}" Padding="18,6"/>
                                <Button Content="Stop listening" Command="{Binding StopListeningCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Connected apps" Style="{StaticResource CardTitle}"/>
                            <ListView ItemsSource="{Binding Clients}" MinHeight="70" MaxHeight="160" BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="App" DisplayMemberBinding="{Binding Name}" Width="170"/>
                                        <GridViewColumn Header="Origin" DisplayMemberBinding="{Binding Origin}" Width="170"/>
                                        <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Kind}" Width="60"/>
                                        <GridViewColumn Header="Permissions" DisplayMemberBinding="{Binding Scopes}" Width="170"/>
                                        <GridViewColumn Header="Since" DisplayMemberBinding="{Binding Since}" Width="64"/>
                                        <GridViewColumn Header="Frames" DisplayMemberBinding="{Binding Frames}" Width="64"/>
                                        <GridViewColumn Header="Dropped" DisplayMemberBinding="{Binding Dropped}" Width="64"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Text="Pair another app" FontWeight="SemiBold" Margin="0,10,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Processed" IsChecked="{Binding PairProcessed}" Margin="0,0,12,0"/>
                                <CheckBox Content="Raw EEG" IsChecked="{Binding PairRaw}" Margin="0,0,12,0"/>
                                <CheckBox Content="Send markers" IsChecked="{Binding PairMarkers}" Margin="0,0,12,0"/>
                                <Button Content="Show pairing code" Command="{Binding PairCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PairingCode}" FontSize="28" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding PairingHint}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Markers" Style="{StaticResource CardTitle}"/>
                            <ItemsControl ItemsSource="{Binding MarkerPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Margin="0,0,8,8"
                                                Command="{Binding DataContext.PresetMarkerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MarkerBox" Text="{Binding MarkerText, UpdateSourceTrigger=PropertyChanged}" KeyDown="MarkerBox_KeyDown"/>
                                <Button Grid.Column="1" Content="Add marker" Margin="8,0,0,0" Command="{Binding SendMarkerCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Live signal" Style="{StaticResource CardTitle}"/>
                            <Border Height="170" Background="#FBFAF8" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                <Canvas x:Name="TraceCanvas" SizeChanged="TraceCanvas_SizeChanged">
                                    <Polyline x:Name="Fp1Line" Stroke="#2C7A7B" StrokeThickness="1.2"/>
                                    <Polyline x:Name="Fp2Line" Stroke="#8A5CC2" StrokeThickness="1.2"/>
                                </Canvas>
                            </Border>
                            <TextBlock Text="Fp1 (teal) and Fp2 (purple), filtered 0.5-40 Hz, last 4 s, +/-60 uV per lane." Style="{StaticResource Hint}" Margin="0,4,0,8"/>
                            <ItemsControl ItemsSource="{Binding Bands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"/>
                                            <ProgressBar Grid.Column="1" Value="{Binding BarValue, Mode=OneWay}" Maximum="100" Height="9" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Relative band power, average of both channels." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Log" Style="{StaticResource CardTitle}"/>
                            <ListBox ItemsSource="{Binding LogLines}" Height="130" FontFamily="Consolas" FontSize="11" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>