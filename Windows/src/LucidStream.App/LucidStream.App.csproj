<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projection gives the Bluetooth LE (WinRT) APIs. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for the system-tray NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Explicit usings avoid WPF / WinForms name clashes (Application, MessageBox, ...). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>LucidStream</AssemblyName>
    <RootNamespace>LucidStream.App</RootNamespace>
    <ApplicationTitle>Lucid-Stream</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosts the Lucidify Cloud viewer page (Microsoft Edge WebView2; the runtime ships with Windows 10 and 11). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3240.44" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LucidStream.Core\LucidStream.Core.csproj" />
  </ItemGroup>

</Project>