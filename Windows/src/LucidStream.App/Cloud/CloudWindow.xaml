<Window x:Class="LucidStream.App.Cloud.CloudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Lucid-Stream - Lucidify Cloud" Width="1360" Height="940" MinWidth="900" MinHeight="600"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource BodyBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- ============================================================ recording bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1" Padding="22,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start recording to Cloud" Command="{Binding StartCommand}" Style="{StaticResource Primary}" Padding="20,8"/>
                    <Button Content="Stop" Command="{Binding StopCommand}" Padding="18,8"/>
                    <Button Content="Reload page" Click="Reload_Click" Style="{StaticResource Link}" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LUCIDIFY CLOUD" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding State}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding Target}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding Account}" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================ local vs Cloud -->
        <Border DockPanel.Dock="Top" Padding="22,12,22,10" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Live from the patch (this PC, straight from Bluetooth or the dongle)" Style="{StaticResource SubTitle}" Margin="0,0,0,6"/>
                    <Border Height="110" Background="{StaticResource TraceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="1">
                        <Canvas x:Name="TraceCanvas" ClipToBounds="True" SizeChanged="TraceCanvas_SizeChanged">
                            <Polyline x:Name="AfzLine" Stroke="#38C6D6" StrokeThickness="1.2"/>
                            <Polyline x:Name="Fp2Line" Stroke="#AA73ED" StrokeThickness="1.2"/>
                        </Canvas>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Rectangle Width="14" Height="3" Fill="#38C6D6" VerticalAlignment="Center"/>
                        <TextBlock Text="AFz" Margin="6,0,14,0" Style="{StaticResource Hint}"/>
                        <Rectangle Width="14" Height="3" Fill="#AA73ED" VerticalAlignment="Center"/>
                        <TextBlock Text="Fp2" Margin="6,0,14,0" Style="{StaticResource Hint}"/>
                        <TextBlock Text="Filtered 0.5-40 Hz, last 4 s. The Cloud page below shows what Cloud has received." Style="{StaticResource Hint}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Delay" Style="{StaticResource SubTitle}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Delay}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Cloud receives 5-second chunks, so it trails the patch by at least 5 s plus upload time."
                               Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Problem}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ Cloud viewer -->
        <Grid>
            <wv2:WebView2 x:Name="Web"/>
            <TextBlock x:Name="WebStatus" Text="Loading the Cloud page..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center"/>
        </Grid>
    </DockPanel>
</Window>